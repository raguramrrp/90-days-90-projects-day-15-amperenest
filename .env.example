# Option B: Individual PostgreSQL parameters
# POSTGRES_DB=amperenest_db
# POSTGRES_USER=postgres
# POSTGRES_PASSWORD=postgres
# POSTGRES_HOST=localhost
# POSTGRES_PORT=5432
